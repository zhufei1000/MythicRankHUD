# Build configuration for BigWigsMods/packager (used by the release workflow).
# The international addon lives in the repository root; the regional variant is
# composed from the same Lua sources by tools/build_release.ps1.
package-as: MythicRankHUD
ignore:
  - README.md
  - .agents
  - .codex
  - .github
  - .gitignore
  - .workbuddy
  - releases
  - tests
  - tools
